<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ── a volta do Google ─────────────────────────────────────
                 O Google recusa OAuth dentro de um WebView, então a entrada
                 abre no navegador do sistema. Este esquema é como a resposta
                 volta para cá: cineclube://auth?code=<bilhete de um uso>.
                 Ver routes/auth.js. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cineclube" android:host="auth" />
            </intent-filter>

            <!-- ── o link do clube abrindo aqui dentro ───────────────────
                 `autoVerify` faz o Android conferir, no domínio, que o dono
                 dele reconhece este pacote — é o /.well-known/assetlinks.json
                 servido por server.js. Sem essa conferência o link continua
                 abrindo o navegador, que é o comportamento de antes.

                 O domínio vem de um recurso gerado no build a partir de
                 client/.env.app: escrevê-lo aqui poria o endereço do serviço no
                 repositório. Ver mobile/scripts/links.mjs. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/deeplink_host" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Do Android 13 em diante, avisar precisa de permissão pedida em tempo de
         execução — e o pedido só aparece se ela estiver declarada aqui. Sem
         isto o interruptor de Avisos liga e nada chega. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
