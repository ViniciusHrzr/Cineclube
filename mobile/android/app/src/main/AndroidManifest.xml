<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ── a volta do Google ─────────────────────────────────────
                 O Google recusa OAuth dentro de um WebView, então a entrada
                 abre no navegador do sistema. Este esquema é como a resposta
                 volta para cá: cineclube://auth?code=<bilhete de um uso>.
                 Ver routes/auth.js. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cineclube" android:host="auth" />
            </intent-filter>

            <!-- ── o link do clube abrindo aqui dentro ───────────────────
                 `autoVerify` faz o Android conferir, no domínio, que o dono
                 dele reconhece este pacote — é o /.well-known/assetlinks.json
                 servido por server.js. Sem essa conferência o link continua
                 abrindo o navegador, que é o comportamento de antes.

                 O domínio vem de um recurso gerado no build a partir de
                 client/.env.app: escrevê-lo aqui poria o endereço do serviço no
                 repositório. Ver mobile/scripts/links.mjs. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- `path="/"` e não o domínio inteiro. Sem ele este filtro
                     engole TODO endereço daquele host — inclusive a ida ao
                     Google, que sai deste app para o navegador e voltava para
                     cá no meio do caminho, antes de haver conta nenhuma.

                     As telas do clube vivem todas na raiz: o que muda depois do
                     `#` não entra na comparação de caminho que o Android faz. -->
                <data android:scheme="https" android:host="@string/deeplink_host" android:path="/" />
            </intent-filter>

        </activity>

        <!-- ── o serviço que segura a transmissão ────────────────────
             Capturar a tela exige, do Android 10 em diante, um serviço em
             primeiro plano com notificação; do 14 em diante ele precisa
             declarar que é de PROJEÇÃO. Ver screencast/ScreenCastService.java. -->
        <service
            android:name="com.cineclube.app.screencast.ScreenCastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Do Android 13 em diante, avisar precisa de permissão pedida em tempo de
         execução — e o pedido só aparece se ela estiver declarada aqui. Sem
         isto o interruptor de Avisos liga e nada chega. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Transmitir a tela. A captura em si é autorizada pela pessoa num
         diálogo do sistema, a cada vez; estas duas são para o serviço que
         mantém a captura de pé enquanto o app não está na frente. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Opcional, e desligado por padrão: a voz de quem transmite. O som do
         SISTEMA não vai junto nesta versão — ver CastEngine. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
