{
  "name": "cineclube-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc -b && vite build",
    "preview": "vite preview",
    "build:app": "node scripts/check-app-env.mjs && npm run assets && tsc -b && vite build --mode app --outDir ../mobile/www --emptyOutDir",
    "assets": "npm run vendor:sw && npm run icons",
    "vendor:sw": "node scripts/vendor-sw.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
