{
  "name": "cineclube",
  "version": "1.0.0",
  "private": true,
  "description": "App de avaliação de filmes do cineclube — catálogo via TMDB, avaliações persistidas em SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "migrate:turso": "node scripts/migrate-to-turso.js",
    "migrate:criterios": "node scripts/migrate-criteria-keys.js",
    "doc:criterios": "node scripts/criterios-doc.js",
    "backfill:runtimes": "node scripts/backfill-runtimes.js",
    "backfill:notas": "node scripts/backfill-tmdb-scores.js",
    "backfill:ingles": "node scripts/backfill-english-titles.js",
    "backfill:fila": "node scripts/backfill-watchlist-owner.js",
    "recalcular:notas": "node scripts/recompute-finals.js",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "express": "^4.19.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
