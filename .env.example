PORT=3000

# O TMDB tem duas credenciais e só uma serve aqui: o app autentica com
# `Authorization: Bearer`, que exige o API Read Access Token (v4) — um JWT
# longo, começando com "eyJ". A API Key v3 (32 caracteres hex) devolve
# "Invalid API key" neste header. Pegue a v4 em:
# themoviedb.org -> Settings -> API -> API Read Access Token
TMDB_TOKEN=seu_api_read_access_token_v4

# Só em produção, atrás de HTTPS: marca o cookie de sessão como Secure.
# CINECLUBE_HTTPS=1

# Em produção o banco é o Turso. Sem estas, o app abre data/cineclube.db.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...
