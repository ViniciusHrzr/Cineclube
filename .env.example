PORT=3000

# O TMDB tem duas credenciais e só uma serve aqui: o app autentica com
# `Authorization: Bearer`, que exige o API Read Access Token (v4) — um JWT
# longo, começando com "eyJ". A API Key v3 (32 caracteres hex) devolve
# "Invalid API key" neste header. Pegue a v4 em:
# themoviedb.org -> Settings -> API -> API Read Access Token
TMDB_TOKEN=seu_api_read_access_token_v4

# Só em produção, atrás de HTTPS: marca o cookie de sessão como Secure.
# CINECLUBE_HTTPS=1

# Em produção o banco é o Turso. Sem estas, o app abre data/cineclube.db.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...

# ── A tela ao vivo ────────────────────────────────────────────────────────
# Na Sessão, uma pessoa pode transmitir a própria tela e o resto do clube
# recebe por WebRTC. A imagem vai direto de navegador a navegador; o servidor
# só apresenta os dois. Nada abaixo é obrigatório — sem nenhuma variável, sobra
# o STUN público e funciona para quem não estiver atrás de CGNAT.
#
# STUN responde "de onde veio este pacote", e é o que basta na maioria das
# redes. Só mude se não quiser depender do Google e da Cloudflare.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
#
# TURN é o servidor que carrega o vídeo no meio, para quando os dois lados não
# conseguem se achar — operadora móvel e alguns provedores. Ele custa banda:
# um filme de duas horas são uns 2 GB por pessoa que precisar dele.
# TURN_URLS=turn:seu-relay:3478?transport=udp,turns:seu-relay:5349
#
# Duas formas de credencial, e basta uma. O segredo compartilhado é o certo —
# a senha que chega ao navegador expira em algumas horas. É o `use-auth-secret`
# do coturn.
# TURN_SECRET=o_mesmo_segredo_do_coturn
#
# Ou usuário e senha fixos, que é o que os serviços prontos entregam no painel.
# Funciona igual; a diferença é que essa senha não expira e vai para o
# navegador de todo mundo do clube.
# TURN_USERNAME=...
# TURN_PASSWORD=...
